+def _build_hard_anchor_block(mode, visual_dict, initial_prompt=""):
+    visual_dict = visual_dict if isinstance(visual_dict, dict) else {}
+    checklist = visual_dict.get("__visual_checklist")
+    if not isinstance(checklist, dict):
+        tc = visual_dict.get("__trace_context")
+        checklist = tc.get("visual_checklist") if isinstance(tc, dict) else {}
+    request = _v1540_extract_request(initial_prompt)
+    anchors = []
+    for key, label in [
+        ("scene_summary", "Scene"), ("setting_anchor", "Scene"), ("time_anchor", "Time"),
+        ("activity", "Activity"), ("primary_action", "Action"), ("outfit_intent", "Outfit"),
+    ]:
+        value = _clean_text_compact(visual_dict.get(key))
+        if value and all(value.lower() not in x.lower() for x in anchors):
+            anchors.append(f"{label}: {value}")
+    lines = [
+        _v1540_compact_identity_line(),
+        _v1540_people_rule(checklist),
+    ]
+    lines.extend(anchors[:5])
+    if request:
+        lines.append(f"Request: {request}")
+    lines.append("Priority: preserve the requested story and activity; Xiaoxia remains the clear protagonist. Leave natural pose, expression, lighting nuance, and composition to Seedream unless explicitly specified.")
+    return "\n".join(lines).strip()
+
